    "/api/vertex-agent/due_diligence_person_start": {
      "post": {
        "summary": "due_diligence_person_start",
        "description": "Start a full due-diligence / background check on a PERSON, anchored on their mobile number (optionally add name, PAN, DOB, email, city). Covers PEP, sanctions, enforcement, cybercrime, breaches, directorships, and adverse media. PREMIUM and ASYNC (~40-70s): it returns a job_id \u2014 poll check_job until status is 'complete'. Requires consent: ask the user to open the consent link in portal.outris.com/mcp and pass the consent_token.",
        "operationId": "due_diligence_person_start",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "description": "Indian mobile number (10-digit, with or without +91)."
                  },
                  "consent_token": {
                    "type": "string",
                    "description": "Server-issued consent token (preferred)."
                  },
                  "consent": {
                    "type": "string",
                    "description": "Deprecated legacy consent flag ('Y'); migration only."
                  },
                  "name": {
                    "type": "string",
                    "description": "Optional subject full name."
                  },
                  "pan": {
                    "type": "string",
                    "description": "Optional PAN \u2014 strongest key for PEP/enforcement."
                  },
                  "dob": {
                    "type": "string",
                    "description": "Optional date of birth (disambiguates common names)."
                  },
                  "email": {
                    "type": "string",
                    "description": "Optional subject email."
                  },
                  "city": {
                    "type": "string",
                    "description": "Optional city (adverse-media disambiguation)."
                  }
                },
                "required": [
                  "phone"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input arguments"
          },
          "401": {
            "description": "Authentication failure"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "502": {
            "description": "Upstream provider error"
          }
        }
      }
    },
