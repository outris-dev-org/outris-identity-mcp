        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "description": "Indian mobile number (10-digit, with or without +91)."
                  },
                  "consent_token": {
                    "type": "string",
                    "description": "Server-issued consent token from portal.outris.com/mcp (preferred)."
                  },
                  "consent": {
                    "type": "string",
                    "description": "Deprecated legacy consent flag ('Y'); accepted only during migration."
