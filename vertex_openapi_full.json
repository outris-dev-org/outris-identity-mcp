          },
          "401": {
            "description": "Authentication failure"
          },
          "402": {
            "description": "Insufficient credits"
          },
          "502": {
            "description": "Upstream provider error"
          }
        }
      }
    },
    "/api/vertex-agent/find_contacts": {
      "post": {
        "summary": "find_contacts",
        "description": "Skip-trace an Indian mobile number for the person's ALTERNATE phone numbers and current, geocoded addresses. Requires the end user's consent: ask the user to open the consent link in portal.outris.com/mcp and pass the consent_token they receive. Best for: debt collection, locating a person. Never fabricate consent.",
